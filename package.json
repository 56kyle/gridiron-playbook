{
  "name": "gridiron-playbook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "npm run wasm && vite --host 127.0.0.1",
    "build": "npm run wasm && vue-tsc --noEmit && vite build",
    "build:test": "npm run wasm && vue-tsc --noEmit && vite build --mode test",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "tsx --test web/tests/*.test.ts",
    "test:browser": "playwright test --config web/playwright.config.ts"
  },
  "dependencies": {
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.14"
  }
}
